<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@id/onboardingFragment"
        android:name="com.example.nayanepal.ui.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@id/loginFragment"
        android:name="com.example.nayanepal.core.auth.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@id/action_loginFragment_to_passwordResetFragment"
            app:destination="@id/passwordResetFragment" />
    </fragment>

    <fragment
        android:id="@id/registerFragment"
        android:name="com.example.nayanepal.core.auth.ui.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@id/passwordResetFragment"
        android:name="com.example.nayanepal.core.auth.ui.PasswordResetFragment"
        android:label="Reset Password"
        tools:layout="@layout/fragment_password_reset" />

    <fragment
        android:id="@id/homeFragment"
        android:name="com.example.nayanepal.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@id/action_homeFragment_to_verificationFragment"
            app:destination="@id/verificationFragment" />
        <action
            android:id="@id/action_homeFragment_to_marketplaceFragment"
            app:destination="@id/marketplaceFragment" />
        <action
            android:id="@id/action_homeFragment_to_learningFragment"
            app:destination="@id/learningFragment" />
        <action
            android:id="@id/action_homeFragment_to_agricultureFragment"
            app:destination="@id/agricultureFragment" />
        <action
            android:id="@id/action_homeFragment_to_walletFragment"
            app:destination="@id/walletFragment" />
        <action
            android:id="@id/action_homeFragment_to_healthFragment"
            app:destination="@id/healthFragment" />
        <action
            android:id="@id/action_homeFragment_to_tourismFragment"
            app:destination="@id/tourismFragment" />
        <action
            android:id="@id/action_homeFragment_to_accountingFragment"
            app:destination="@id/accountingFragment" />
        <action
            android:id="@id/action_homeFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment" />
    </fragment>

    <fragment
        android:id="@id/accountingFragment"
        android:name="com.example.nayanepal.feature.accounting.ui.AccountingDashboardFragment"
        android:label="Accounting"
        tools:layout="@layout/fragment_accounting_dashboard" />

    <fragment
        android:id="@id/verificationFragment"
        android:name="com.example.nayanepal.ui.verification.VerificationFragment"
        android:label="Verification"
        tools:layout="@layout/fragment_verification">
        <action
            android:id="@id/action_verificationFragment_to_cameraFragment"
            app:destination="@id/cameraFragment" />
        <action
            android:id="@id/action_verificationFragment_to_documentSelectionFragment"
            app:destination="@id/documentSelectionFragment" />
    </fragment>

    <fragment
        android:id="@id/cameraFragment"
        android:name="com.example.nayanepal.ui.camera.CameraFragment"
        android:label="Smart Capture"
        tools:layout="@layout/fragment_camera" />

    <fragment
        android:id="@id/documentSelectionFragment"
        android:name="com.example.nayanepal.ui.verification.DocumentSelectionFragment"
        android:label="Document Selection"
        tools:layout="@layout/fragment_document_selection">
        <action
            android:id="@id/action_documentSelectionFragment_to_documentCaptureFragment"
            app:destination="@id/documentCaptureFragment" />
    </fragment>

    <fragment
        android:id="@id/documentCaptureFragment"
        android:name="com.example.nayanepal.ui.verification.DocumentCaptureFragment"
        android:label="Document Capture"
        tools:layout="@layout/fragment_document_capture">
        <action
            android:id="@id/action_documentCaptureFragment_to_submissionConfirmationFragment"
            app:destination="@id/submissionConfirmationFragment" />
    </fragment>

    <fragment
        android:id="@id/submissionConfirmationFragment"
        android:name="com.example.nayanepal.ui.verification.SubmissionConfirmationFragment"
        android:label="Submission Confirmation"
        tools:layout="@layout/fragment_submission_confirmation">
        <action
            android:id="@id/action_submissionConfirmationFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@id/marketplaceFragment"
        android:name="com.example.nayanepal.ui.marketplace.MarketplaceFragment"
        android:label="Marketplace"
        tools:layout="@layout/fragment_marketplace" />

    <fragment
        android:id="@id/learningFragment"
        android:name="com.example.nayanepal.ui.learning.LearningFragment"
        android:label="Micro Learning"
        tools:layout="@layout/fragment_learning" />

    <fragment
        android:id="@id/agricultureFragment"
        android:name="com.example.nayanepal.ui.agriculture.AgricultureFragment"
        android:label="Smart Agriculture"
        tools:layout="@layout/fragment_agriculture" />

    <fragment
        android:id="@id/walletFragment"
        android:name="com.example.nayanepal.ui.wallet.WalletFragment"
        android:label="Digital Wallet"
        tools:layout="@layout/fragment_wallet" />

    <fragment
        android:id="@id/healthFragment"
        android:name="com.example.nayanepal.ui.health.HealthFragment"
        android:label="Health"
        tools:layout="@layout/fragment_health" />

    <fragment
        android:id="@id/tourismFragment"
        android:name="com.example.nayanepal.ui.tourism.TourismFragment"
        android:label="Tourism"
        tools:layout="@layout/fragment_tourism" />

    <fragment
        android:id="@id/profileFragment"
        android:name="com.example.nayanepal.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@id/notificationsFragment"
        android:name="com.example.nayanepal.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@id/adminDashboardFragment"
        android:name="com.example.nayanepal.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@id/action_adminDashboardFragment_to_adminReviewFragment"
            app:destination="@id/adminReviewFragment" />
    </fragment>

    <fragment
        android:id="@id/adminReviewFragment"
        android:name="com.example.nayanepal.ui.admin.AdminReviewFragment"
        android:label="Review Document"
        tools:layout="@layout/fragment_admin_review">
        <argument
            android:name="documentId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@id/settingsFragment"
        android:name="com.example.nayanepal.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</navigation>
