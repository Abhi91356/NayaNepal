<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =========================================
         APP THEME
         ========================================= -->
    <style name="Theme.NayaNepal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryDark">@color/primary_700</item>
        <item name="colorAccent">@color/accent_500</item>
        <item name="android:windowBackground">@color/neutral_50</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Material component overrides -->
        <item name="materialButtonStyle">@style/Component.Button.Primary</item>
        <item name="textInputStyle">@style/Component.Input.Outlined</item>
        <item name="bottomNavigationStyle">@style/Component.BottomNav</item>
    </style>

    <!-- =========================================
         BUTTON STYLES
         ========================================= -->

    <!-- Primary solid button — main CTA -->
    <style name="Component.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/btn_height_large</item>
        <item name="android:paddingStart">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/primary_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary outlined button -->
    <style name="Component.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/btn_height_large</item>
        <item name="android:paddingStart">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/primary_500</item>
        <item name="android:textColor">@color/primary_500</item>
    </style>

    <!-- Ghost/Text button — low emphasis -->
    <style name="Component.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_500</item>
        <item name="rippleColor">@color/primary_100</item>
    </style>

    <!-- Social login button (Google, Facebook) -->
    <style name="Component.Button.Social" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/btn_height_large</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/neutral_900</item>
        <item name="strokeColor">@color/neutral_300</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- =========================================
         INPUT FIELD STYLES
         ========================================= -->
    <style name="Component.Input.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_medium</item>
        <item name="boxStrokeColor">@color/input_stroke_color</item>
        <item name="hintTextColor">@color/primary_500</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- =========================================
         CARD STYLES
         ========================================= -->
    <style name="Component.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="contentPadding">@dimen/space_20</item>
        <item name="strokeColor">@color/neutral_100</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Component.Card.Flat" parent="Component.Card">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/neutral_100</item>
    </style>

    <!-- =========================================
         BOTTOM NAVIGATION
         ========================================= -->
    <style name="Component.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/BottomNav.ActiveIndicator</item>
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BottomNav.ActiveIndicator"
           parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_100</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Rounded</item>
    </style>

    <style name="ShapeAppearance.Rounded" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

</resources>
