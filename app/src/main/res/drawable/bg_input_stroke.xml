<!-- Input field border color selector — normal vs focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <color android:color="@color/primary_500"/>
    </item>
    <item android:state_enabled="false">
        <color android:color="@color/neutral_300"/>
    </item>
    <item>
        <color android:color="@color/neutral_300"/>
    </item>
</selector>