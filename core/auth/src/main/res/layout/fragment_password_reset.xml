<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_24"
    android:background="@color/white">

    <TextView
        style="@style/Type.Heading.H1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password 🔐" />

    <TextView
        style="@style/Type.Body.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="We will send an OTP to your phone or email to verify."
        android:textColor="@color/neutral_500" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIdentifier"
        style="@style/Component.Input.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_40"
        android:hint="Email or Phone">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIdentifier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSendResetCode"
        style="@style/Component.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        android:text="Send Reset Code" />

</LinearLayout>
